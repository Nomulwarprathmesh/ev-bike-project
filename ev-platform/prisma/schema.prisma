generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  customer
  vendor_owner
  vendor_staff
  moderator
  finance_admin
  super_admin
}

enum UserStatus {
  active
  inactive
  suspended
  pending
}

enum VendorStatus {
  pending
  approved
  rejected
  suspended
}

enum EntityStatus {
  active
  inactive
}

enum ProductStatus {
  draft
  pending_approval
  approved
  rejected
  inactive
  out_of_stock
  discontinued
}

enum OrderStatus {
  pending
  confirmed
  approved
  packed
  shipped
  delivered
  cancelled
  disputed
  refunded
}

enum BookingType {
  full_payment
  emi
  test_ride
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

enum PaymentMode {
  UPI
  Card
  EMI
  NetBanking
  Wallet
}

enum StockMovementType {
  restock
  sale
  reservation
  release
  adjustment
  return
  low_stock_alert
}

enum TestRideStatus {
  pending
  confirmed
  completed
  cancelled
  no_show
}

enum FollowUpStatus {
  not_contacted
  call_scheduled
  interested
  converted
  not_interested
}

enum LeadStatus {
  new
  contacted
  qualified
  converted
  lost
}

enum Priority {
  low
  medium
  high
  urgent
}

enum ReviewStatus {
  approved
  pending
  rejected
  reported
}

enum SupportTicketStatus {
  open
  in_progress
  resolved
  escalated
  closed
}

enum RefundStatus {
  pending
  approved
  rejected
  processing
  disputed
}

model User {
  id              String            @id @default(cuid())
  name            String
  email           String            @unique
  phone           String?
  passwordHash    String
  role            UserRole          @default(customer)
  status          UserStatus        @default(active)
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  refreshTokens   RefreshToken[]
  adminUser       AdminUser?
  vendorUsers     VendorUser[]
  carts           Cart[]
  wishlists       Wishlist[]
  compareItems    CompareItem[]
  orders          Order[]
  addresses       Address[]
  reviews         Review[]
  testRides       TestRideBooking[]
  notifications   Notification[]
  supportTickets  SupportTicket[]   @relation("CustomerTickets")

  @@index([role, status])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model AdminUser {
  id         String     @id @default(cuid())
  userId     String     @unique
  department String?
  roleId     String?
  status     UserStatus @default(active)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role?      @relation(fields: [roleId], references: [id])
}

model Role {
  id          String       @id @default(cuid())
  name        String
  type        UserRole
  description String?
  permissions Permission[]
  adminUsers  AdminUser[]
}

model Permission {
  id         String  @id @default(cuid())
  roleId     String
  module     String
  canView    Boolean @default(false)
  canEdit    Boolean @default(false)
  canDelete  Boolean @default(false)
  canApprove Boolean @default(false)
  canExport  Boolean @default(false)
  role       Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, module])
}

model Vendor {
  id              String           @id @default(cuid())
  businessName    String
  legalName       String?
  email           String           @unique
  phone           String
  gstNumber       String?
  status          VendorStatus     @default(pending)
  rating          Float            @default(0)
  totalSales      Decimal          @default(0)
  verifiedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  users           VendorUser[]
  showrooms       Showroom[]
  products        Product[]
  orders          Order[]
  payouts         VendorPayout[]

  @@index([status])
}

model VendorUser {
  id       String   @id @default(cuid())
  vendorId String
  userId   String
  role     UserRole @default(vendor_staff)
  vendor   Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([vendorId, userId])
}

model Showroom {
  id        String         @id @default(cuid())
  vendorId  String
  name      String
  city      String
  area      String?
  address   String
  phone     String
  email     String?
  timing    String?
  days      String?
  latitude  Float?
  longitude Float?
  status    EntityStatus   @default(active)
  vendor    Vendor         @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  staff     ShowroomStaff[]
  inventory Inventory[]
  orders    Order[]
  cartItems CartItem[]
  testRides TestRideBooking[]

  @@index([vendorId, city, status])
}

model ShowroomStaff {
  id         String       @id @default(cuid())
  showroomId String
  name       String
  phone      String
  email      String?
  role       String?
  active     Boolean      @default(true)
  showroom   Showroom     @relation(fields: [showroomId], references: [id], onDelete: Cascade)
  testRides  TestRideBooking[]
}

model Brand {
  id       String       @id @default(cuid())
  name     String       @unique
  status   EntityStatus @default(active)
  products Product[]
}

model Product {
  id              String          @id @default(cuid())
  vendorId        String?
  brandId         String
  name            String
  model           String?
  description     String?
  price           Decimal
  originalPrice   Decimal?
  discount        Int            @default(0)
  category        String?
  status          ProductStatus  @default(draft)
  approvalStatus  ProductStatus  @default(pending_approval)
  rejectionReason String?
  decisionDate    DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  vendor          Vendor?        @relation(fields: [vendorId], references: [id])
  brand           Brand          @relation(fields: [brandId], references: [id])
  specs           ProductSpec?
  images          ProductImage[]
  colors          ProductColor[]
  inventory       Inventory[]
  cartItems       CartItem[]
  wishlists       Wishlist[]
  compareItems    CompareItem[]
  orderItems      OrderItem[]
  reviews         Review[]
  testRides       TestRideBooking[]

  @@index([approvalStatus, status])
  @@index([brandId, price])
}

model ProductSpec {
  productId            String  @id
  rangeKm              Int?
  topSpeedKmph         Int?
  chargingTimeHours    Float?
  batteryCapacityKwh   Float?
  motorPowerWatts      Int?
  weightKg             Float?
  product              Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductColor {
  id        String  @id @default(cuid())
  productId String
  name      String?
  hex       String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Inventory {
  id                String          @id @default(cuid())
  showroomId        String
  productId         String
  stock             Int             @default(0)
  reservedStock     Int             @default(0)
  lowStockThreshold Int             @default(5)
  updatedAt         DateTime        @updatedAt
  showroom          Showroom        @relation(fields: [showroomId], references: [id], onDelete: Cascade)
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  movements         StockMovement[]

  @@unique([showroomId, productId])
  @@index([productId])
}

model StockMovement {
  id            String            @id @default(cuid())
  inventoryId   String
  productId     String
  showroomId    String
  type          StockMovementType
  quantity      Int
  reason        String?
  note          String?
  referenceType String?
  referenceId   String?
  createdBy     String?
  createdAt     DateTime          @default(now())
  inventory     Inventory         @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([productId, showroomId, createdAt])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String
  status    String     @default("active")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@unique([userId, status])
}

model CartItem {
  id            String    @id @default(cuid())
  cartId        String
  productId     String
  showroomId    String?
  quantity      Int       @default(1)
  priceSnapshot Decimal?
  cart          Cart      @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product       Product   @relation(fields: [productId], references: [id])
  showroom      Showroom? @relation(fields: [showroomId], references: [id])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model CompareItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  name      String
  phone     String
  street    String
  city      String
  state     String
  pincode   String
  country   String  @default("India")
  isDefault Boolean @default(false)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders    Order[]
}

model Order {
  id                String               @id @default(cuid())
  orderNumber       String               @unique
  userId            String
  vendorId          String?
  showroomId        String?
  status            OrderStatus          @default(pending)
  bookingType       BookingType          @default(full_payment)
  subtotal          Decimal              @default(0)
  discount          Decimal              @default(0)
  tax               Decimal              @default(0)
  totalAmount       Decimal              @default(0)
  paymentStatus     PaymentStatus        @default(pending)
  deliveryAddressId String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  user              User                 @relation(fields: [userId], references: [id])
  vendor            Vendor?              @relation(fields: [vendorId], references: [id])
  showroom          Showroom?            @relation(fields: [showroomId], references: [id])
  deliveryAddress   Address?             @relation(fields: [deliveryAddressId], references: [id])
  items             OrderItem[]
  payments          Payment[]
  refunds           Refund[]
  statusHistory     OrderStatusHistory[]
  reviews           Review[]

  @@index([userId, status, createdAt])
  @@index([vendorId, status])
  @@index([paymentStatus])
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  productId  String
  productName String
  quantity   Int
  unitPrice  Decimal
  totalPrice Decimal
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product @relation(fields: [productId], references: [id])
}

model OrderStatusHistory {
  id         String       @id @default(cuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  note       String?
  changedBy  String?
  createdAt  DateTime     @default(now())
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Payment {
  id               String        @id @default(cuid())
  orderId          String
  gateway          String
  gatewayPaymentId String?
  paymentMode      PaymentMode?
  amount           Decimal
  status           PaymentStatus @default(pending)
  failureReason    String?
  retryCount       Int           @default(0)
  lastAttemptAt    DateTime?
  createdAt        DateTime      @default(now())
  order            Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds          Refund[]

  @@index([gateway, status, createdAt])
}

model Refund {
  id             String       @id @default(cuid())
  orderId        String
  paymentId      String?
  customerId     String?
  vendorId       String?
  reason         String
  amount         Decimal
  status         RefundStatus @default(pending)
  hasEvidence    Boolean      @default(false)
  autoEligible   Boolean      @default(false)
  vendorDisputed Boolean      @default(false)
  createdAt      DateTime     @default(now())
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment        Payment?     @relation(fields: [paymentId], references: [id])
}

model VendorPayout {
  id              String        @id @default(cuid())
  vendorId        String
  ordersDelivered Int           @default(0)
  grossSales      Decimal       @default(0)
  commission      Decimal       @default(0)
  deductions      Decimal       @default(0)
  netPayout       Decimal       @default(0)
  status          PaymentStatus @default(pending)
  settlementDate  DateTime?
  vendor          Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

model FinanceLead {
  id             String   @id @default(cuid())
  userId         String?
  productId      String?
  loanAmount     Decimal
  downPayment    Decimal?
  tenureMonths   Int
  interestRate   Float?
  monthlyIncome  Decimal?
  employmentType String?
  status         LeadStatus @default(new)
  createdAt      DateTime @default(now())
}

model TestRideBooking {
  id              String         @id @default(cuid())
  bookingNumber   String         @unique
  userId          String
  productId       String
  showroomId      String
  date            DateTime
  timeSlot        String
  status          TestRideStatus @default(pending)
  assignedStaffId String?
  followUpStatus  FollowUpStatus @default(not_contacted)
  notes           String?
  createdAt       DateTime       @default(now())
  user            User           @relation(fields: [userId], references: [id])
  product         Product        @relation(fields: [productId], references: [id])
  showroom        Showroom       @relation(fields: [showroomId], references: [id])
  assignedStaff   ShowroomStaff? @relation(fields: [assignedStaffId], references: [id])

  @@index([showroomId, date, status])
}

model Lead {
  id         String     @id @default(cuid())
  vendorId   String?
  showroomId String?
  userId     String?
  productId  String?
  source     String?
  name       String
  email      String?
  phone      String?
  message    String?
  priority   Priority   @default(medium)
  status     LeadStatus @default(new)
  assignedTo String?
  createdAt  DateTime   @default(now())
}

model Review {
  id        String       @id @default(cuid())
  userId    String
  orderId   String?
  productId String
  showroomId String?
  rating    Int
  review    String
  status    ReviewStatus @default(pending)
  sentiment String?
  reported  Boolean      @default(false)
  fraudScore Int?
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id])
  order     Order?       @relation(fields: [orderId], references: [id])
  product   Product      @relation(fields: [productId], references: [id])
  photos    ReviewPhoto[]
  replies   ReviewReply[]

  @@index([productId, status, rating])
}

model ReviewPhoto {
  id       String @id @default(cuid())
  reviewId String
  url      String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

model ReviewReply {
  id       String   @id @default(cuid())
  reviewId String
  vendorId String?
  text     String
  createdAt DateTime @default(now())
  review   Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

model SupportTicket {
  id              String              @id @default(cuid())
  ticketNumber    String              @unique
  customerId      String
  category        String
  priority        Priority            @default(medium)
  assignedAgentId String?
  status          SupportTicketStatus @default(open)
  slaDueAt        DateTime?
  lastUpdateAt    DateTime            @default(now())
  unread          Boolean             @default(false)
  overdue         Boolean             @default(false)
  evReference     String?
  orderReference  String?
  subject         String
  description     String?
  customer        User                @relation("CustomerTickets", fields: [customerId], references: [id])
  messages        TicketMessage[]
}

model TicketMessage {
  id          String        @id @default(cuid())
  ticketId    String
  senderId    String?
  message     String
  attachments Json?
  createdAt   DateTime      @default(now())
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  readAt    DateTime?
  metadata  Json?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  userId     String?
  sessionId  String?
  eventName  String
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([eventName, createdAt])
}
