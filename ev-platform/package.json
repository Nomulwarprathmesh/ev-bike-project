{
  "name": "ev-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise EV commerce platform monorepo",
  "packageManager": "npm@10.9.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean && rimraf .turbo node_modules package-lock.json",
    "clean:apps": "rimraf apps/*/.next apps/*/dist apps/*/build apps/*/.turbo apps/*/.cache",
    "db:generate": "npm run prisma:generate --workspace=@ev-platform/backend",
    "db:migrate": "npm run prisma:migrate --workspace=@ev-platform/backend",
    "db:deploy": "npm run prisma:deploy --workspace=@ev-platform/backend",
    "db:seed": "npm run prisma:seed --workspace=@ev-platform/backend",
    "dev:admin": "turbo dev --filter=@ev-platform/admin",
    "dev:vendor": "turbo dev --filter=@ev-platform/vendor",
    "dev:marketplace": "turbo dev --filter=@ev-platform/marketplace",
    "dev:backend": "turbo dev --filter=@ev-platform/backend"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "turbo": "^2.6.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10.0.0"
  }
}
